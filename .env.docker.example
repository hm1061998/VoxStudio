# Copy to .env.docker and replace every CHANGE_ME. Never commit .env.docker.
NODE_ENV=production
LOG_LEVEL=info
VOXSTUDIO_DOMAIN=localhost
PUBLIC_BASE_URL=https://localhost
CORS_ORIGINS=https://localhost
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
# At least 32 random characters, e.g. `openssl rand -hex 32`.
AUTH_SECRET=CHANGE_ME_at_least_32_random_characters
COOKIE_SECURE=true
ADMIN_EMAILS=
API_PORT=4000
WORKER_CONCURRENCY=2
PREVIEW_MAX_CHARS=1000
SEGMENT_MAX_CHARS=5000
RENDER_MAX_CHARS=100000
RENDER_TIMEOUT_SECONDS=600
ENGINE_TIMEOUT_SECONDS=60

# --- Engines (ADR 0008 / 0009). The default product offers the AI voices only.
ENABLED_ENGINES=vieneu
VIENEU_SERVICE_URLS=http://vieneu:8765
VIENEU_SERVICE_TOKEN=CHANGE_ME_random_token_at_least_16_characters
VIENEU_APPROVED=true
VIENEU_INSTANCES=1
VIENEU_THREADS=4
QUEUE_AGING_SECONDS=30

# --- Accounts and security (docs/upgrade/10-SECURITY-AND-ACCESS.md)
# Set to false to close self-registration; then create admins/users with scripts/user-admin.mjs or reopen briefly.
ALLOW_REGISTRATION=true
# Idle sessions end after this many hours; sessions always end after 7 days.
SESSION_IDLE_HOURS=24
# Caddy runs in the private docker network and sets X-Forwarded-For; trust private-range proxies only.
TRUST_PROXY=uniquelocal

# Disk protection: free-space thresholds (percent of the storage disk), cleanup of old records
DISK_WARN_FREE_PERCENT=20
DISK_BLOCK_FREE_PERCENT=8
DISK_MIN_FREE_MB=1024
JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180

# Optional billing by bank transfer (docs/upgrade/11-BILLING.md). Leave PLAN_PRICES_VND_JSON empty to keep it off.
PLAN_PRICES_VND_JSON=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=
PAYMENT_WEBHOOK_SECRET=

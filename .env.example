# VoxStudio configuration. Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:4000
API_PORT=4000
# Comma-separated list of allowed browser origins (dev web server runs on 5173).
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

DATABASE_URL=postgresql://voxstudio:CHANGE_ME@127.0.0.1:5433/voxstudio
TEST_DATABASE_URL=postgresql://voxstudio:CHANGE_ME@127.0.0.1:5433/voxstudio_test

# Must be at least 32 random characters. `pnpm db:start` generates one for local dev.
AUTH_SECRET=change-me
# Set true behind TLS (production). Cookies are always HttpOnly + SameSite=Lax.
COOKIE_SECURE=false
# Comma-separated emails granted the admin role on registration/login.
ADMIN_EMAILS=

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
TEMP_DIR=./tmp

WORKER_CONCURRENCY=2
PREVIEW_MAX_CHARS=1000
SEGMENT_MAX_CHARS=5000
RENDER_MAX_CHARS=100000
RENDER_TIMEOUT_SECONDS=600
ENGINE_TIMEOUT_SECONDS=60

# Engine/DSP binaries. Leave empty to use PATH lookups.
ESPEAK_PATH=
ESPEAK_APPROVED_VERSION=1.52.0
FFMPEG_PATH=
FFPROBE_PATH=

# Optional: directory of Vietnamese unit databases (enables the vnunit engine; see docs/upgrade/05-VIETNAMESE-CORE.md)
VN_UNIT_DB_DIR=

# Engines offered to users: vieneu (AI voices, default), espeak (rule-based, other languages / development), vnunit.
# ENABLED_ENGINES=vieneu
# The AI model service lives in services/vieneu (ADR 0008). Required when vieneu is enabled.
# VIENEU_SERVICE_URLS=http://127.0.0.1:8765
# VIENEU_SERVICE_TOKEN=
# VIENEU_APPROVED=false
# QUEUE_AGING_SECONDS=30
# PLAN_LIMITS_JSON={"pro":{"aiMonthlyChars":1000000}}
# Accounts and security (docs/upgrade/10-SECURITY-AND-ACCESS.md)
# ALLOW_REGISTRATION=true
# SESSION_IDLE_HOURS=24
# TRUST_PROXY=loopback

# Disk protection: free-space thresholds (percent of the storage disk), cleanup of old records
DISK_WARN_FREE_PERCENT=20
DISK_BLOCK_FREE_PERCENT=8
DISK_MIN_FREE_MB=1024
JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180

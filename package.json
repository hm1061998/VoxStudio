{
  "name": "voxstudio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:migrate": "pnpm --filter @voxstudio/db migrate:deploy",
    "build": "pnpm --filter @voxstudio/db generate && tsc -b packages/contracts packages/db packages/core apps/api apps/worker && pnpm --filter @voxstudio/web build",
    "typecheck": "tsc -b packages/contracts packages/db packages/core apps/api apps/worker && pnpm --filter @voxstudio/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -b packages/contracts packages/db packages/core apps/api apps/worker && vitest run",
    "build:server": "pnpm --filter @voxstudio/db generate && tsc -b packages/contracts packages/db packages/core apps/api apps/worker",
    "test:e2e": "playwright test",
    "dev:api": "node --enable-source-maps apps/api/dist/main.js",
    "dev:worker": "node --enable-source-maps apps/worker/dist/main.js",
    "dev:web": "pnpm --filter @voxstudio/web dev",
    "start": "node scripts/start-all.mjs",
    "qa:voices": "node scripts/qa-voices.mjs",
    "audit:compliance": "node scripts/compliance-audit.mjs",
    "user:admin": "node scripts/user-admin.mjs",
    "user:reset-password": "node scripts/reset-password.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
